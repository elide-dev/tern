#!/usr/bin/env python3
"""Fake `dns-sd -B TYPE local.` for tests/android_pair.py: streams Add/Rmv rows, as macOS's dns-sd
prints them, for the `bonjour` services (`[{name, type}]`) in state.json in the parent of this
file's directory, until it is killed."""
import json
import sys
import time
from pathlib import Path

STATE = Path(__file__).resolve().parents[1] / 'state.json'


def names(kind):
    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        return set()
    return {entry['name'] for entry in state.get('bonjour', []) if entry['type'].rstrip('.') == kind}


def row(action, kind, name):
    stamp = time.strftime('%H:%M:%S') + '.000'
    print(f'{stamp}  {action}        2  14 local.               {kind}. {name}', flush=True)


if len(sys.argv) != 4 or sys.argv[1] != '-B':
    sys.exit(2)
kind = sys.argv[2].rstrip('.')
print(f'Browsing for {kind}.local.')
print('Timestamp     A/R    Flags  if Domain               Service Type         Instance Name', flush=True)
shown = set()
while True:
    current = names(kind)
    for name in sorted(current - shown):
        row('Add', kind, name)
    for name in sorted(shown - current):
        row('Rmv', kind, name)
    shown = current
    time.sleep(.2)
